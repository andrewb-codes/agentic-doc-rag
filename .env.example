# Copy this file to .env for local development.

# FastAPI database connection used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://rag_user:replace-with-a-long-random-password@postgres:5432/rag

# Shared secret for internal API calls from trusted clients, e.g. Telegram bot.
INTERNAL_API_KEY=replace-with-a-long-random-internal-secret

# Embedding provider used for vector indexing and retrieval
EMBEDDING_API_KEY=replace-with-your-api-key

# LLM provider used for answer generation
LLM_API_KEY=replace-with-your-api-key

# Rate limiting state storage.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=async+redis://localhost:6379/0

# Redis container settings used by docker-compose.
REDIS_PORT=6379

# PostgreSQL container settings used by docker-compose.
POSTGRES_DB=rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Qdrant container settings used by docker-compose.
QDRANT_PORT=6333
