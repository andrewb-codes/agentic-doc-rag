services:
  redis:
    image: "{{ redis_image }}"
    command:
      - redis-server
      - --appendonly
      - "no"
      - --save
      - ""
      - --maxmemory
      - 128mb
      - --maxmemory-policy
      - volatile-ttl
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 30s
    networks:
      - default
    restart: unless-stopped

  postgres:
    image: "{{ postgres_image }}"
    environment:
      POSTGRES_DB: "${POSTGRES_DB:?POSTGRES_DB is required}"
      POSTGRES_USER: "${POSTGRES_USER:?POSTGRES_USER is required}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}"
    volumes:
      - rag_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}" ]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 30s
    networks:
      - default
    restart: unless-stopped

  qdrant:
    image: "{{ qdrant_image }}"
    volumes:
      - rag_qdrant_data:/qdrant/storage
    healthcheck:
      test: [ "CMD-SHELL", "timeout 3 bash -c '</dev/tcp/localhost/6333'" ]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 30s
    networks:
      - default
    restart: unless-stopped

  api:
    image: "{{ api_image_ref }}"
    env_file:
      - .env
    environment:
      DATABASE_URL: "postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD_URLENCODED}@postgres:5432/${POSTGRES_DB}"
      QDRANT_URL: "http://qdrant:6333"
      RATE_LIMIT_REDIS_URL: "async+redis://redis:6379/0"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      qdrant:
        condition: service_healthy
    healthcheck:
      test: [ "CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)\"" ]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 30s
    networks:
      - default
    restart: unless-stopped

  bot:
    image: "{{ bot_image_ref }}"
    environment:
      INTERNAL_API_KEY: "${INTERNAL_API_KEY:?INTERNAL_API_KEY is required}"
      TELEGRAM_BOT_TOKEN: "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is required}"
      API_BASE_URL: "http://api:8000"
    depends_on:
      api:
        condition: service_healthy
    networks:
      - default
    restart: unless-stopped

volumes:
  rag_postgres_data:
  rag_qdrant_data:
