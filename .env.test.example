# FastAPI database connection for local test runs.
# Use host "localhost" here because pytest and local Alembic run on the host machine.
# Keep the same PostgreSQL user/password as .env, but use the host-published port.
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_test

# Shared secret for internal API calls from trusted clients, e.g. Telegram bot.
INTERNAL_API_KEY=test-internal-api-key

# Fake embedding provider used for vector indexing and retrieval
EMBEDDING_API_KEY=test-api-key

# Fake LLM provider used for answer generation
LLM_API_KEY=test-api-key

# Rate limiting state storage.
RATE_LIMIT_ENABLED=false

# Runtime environment and structured logging.
ENVIRONMENT=test

# CORS origins used by API tests.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
